        "search": '<tg-emoji emoji-id="5253944419870062295">🍂</tg-emoji>',
        "error": '<tg-emoji emoji-id="5281026503658728615">🍁</tg-emoji>',
        "warn": '<tg-emoji emoji-id="5447644880824181073">⚠️</tg-emoji>',
        "description": '<tg-emoji emoji-id="5406631276042002796">📜</tg-emoji>',
        "command": '<tg-emoji emoji-id="5212963577098417551">🍂</tg-emoji>',
        "placeholder": '<tg-emoji emoji-id="5363965354391388799">🗒️</tg-emoji>',
        "module": '<tg-emoji emoji-id="5249157915041865558">🍄</tg-emoji>',
        "capabilities": '<tg-emoji emoji-id="5226513232549664618">🧩</tg-emoji>',
        "modules_list": '<tg-emoji emoji-id="5305495722618010655">🍂</tg-emoji>',
    },
}

MEMORY = {"settings": None, "cache": {}}


def state_get(key, default=None):
    try:
        value = cap("state", {"op": "get", "key": key})
    except Exception:
        return default
    return default if value is None else value


def state_set(key, value):
    try:
        cap("state", {"op": "set", "key": key, "value": value})
    except Exception:
        pass


def settings():
    if MEMORY["settings"] is None:
        stored = state_get("settings", {})
        MEMORY["settings"] = stored if isinstance(stored, dict) else {}
    return MEMORY["settings"]


def save_settings(**values):
    current = settings()
    if all(current.get(key) == value for key, value in values.items()):
        return current
    current.update(values)
    state_set("settings", current)
    return current


def remember(ctx):
    config = dict(DEFAULTS)
    for key, value in (getattr(ctx, "config", None) or {}).items():
        if key in DEFAULTS and value is not None:
            config[key] = value
    language = str(getattr(getattr(ctx, "i18n", None), "language", "") or settings().get("language") or "en")
    return save_settings(language=language, config=config, prefix=str(ctx.prefix or "."))


def lang():
    code = str(settings().get("language") or "en").lower().replace("_", "-").split("-")[0]
    code = LANGUAGES.get(code, code)
    return code if code in STRINGS else "en"


def tr(key, **values):
    text = STRINGS[lang()].get(key) or STRINGS["en"][key]
    return text.format(**values) if values else text


def conf(key):
    return (settings().get("config") or {}).get(key, DEFAULTS[key])


def prefix():
    return str(settings().get("prefix") or ".")


def emoji(key):
    return THEMES.get(conf("theme"), THEMES["default"])[key]


def esc(value):
    return html.escape(str(value), quote=False)


def visible(text):
    return len(re.sub(r"<[^>]+>", "", text))


def unwrap(value):
    if isinstance(value, dict) and set(value) == {"result"}:
        return value["result"]
    return value


def request(method, path, params=None, payload=None, token=None):
    options = {"method": method, "timeout": 10, "headers": {"Authorization": token} if token else {}}
    if params:
        options["params"] = {key: value for key, value in params.items() if value is not None}
    if payload is not None:
        options["json"] = payload
    try:
        response = net(f"{API}/{path}", **options)
    except Exception:
        return None, None
    status = response.get("status")
    try:
        return status, json.loads(response.get("body") or "null")
    except ValueError:
        return status, None


def self_id():
    uid = settings().get("user_id")
    if uid:
        return uid
    try:
        data = unwrap(mt("users.getUsers", id=[{"_": "inputUserSelf"}]))
    except Exception:
        return None
    users = data if isinstance(data, list) else (data or {}).get("users", []) if isinstance(data, dict) else []
    uid = users[0].get("id") if users and isinstance(users[0], dict) else None
    if uid:
        save_settings(user_id=uid)
    return uid


def sent_id(result):
    result = unwrap(result)
    if isinstance(result, dict):
        if isinstance(result.get("id"), int):
            return result["id"]
        for update in result.get("updates", []) or []:
            if isinstance(update, dict):
                if update.get("_") == "updateMessageID" and isinstance(update.get("id"), int):
                    return update["id"]
                message = update.get("message")
                if isinstance(message, dict) and isinstance(message.get("id"), int):
                    return message["id"]
    return 0


def history(limit=5):
    try:
        data = unwrap(mt("messages.getHistory", peer=BOT_USERNAME, limit=limit, offset_id=0, offset_date=0, add_offset=0, max_id=0, min_id=0, hash=0))
    except Exception:
        return []
    return [m for m in (data or {}).get("messages", []) if isinstance(m, dict)] if isinstance(data, dict) else []


def delete_messages(ids):
    ids = [i for i in ids if isinstance(i, int) and i > 0]
    if ids:
        try:
            mt("messages.deleteMessages", id=ids, revoke=True)
        except Exception:
            pass


async def obtain_token():
    try:
        mt("contacts.unblock", id=BOT_USERNAME)
    except Exception:
        pass
    try:
        start = sent_id(mt("messages.sendMessage", peer=BOT_USERNAME, message="/token", random_id=random.getrandbits(63)))
    except Exception:
        return None
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        for message in history():
            text = str(message.get("message") or "").strip()
            if message.get("id", 0) > start and not message.get("out") and text:
                save_settings(token=text)
                return text
        await asyncio.sleep(0.5)
    return None


async def token(refresh=False):
    current = settings().get("token")
    if current and not refresh:
        return current
    return await obtain_token()


async def check_token():
    current = settings().get("token")
    uid = self_id()
    if current and uid:
        status, valid = request("GET", "validatetkn", {"user_id": str(uid)}, token=current)
        if status == 200 and valid is True:
            return current
    return await obtain_token()


def prepare():
    try:
        mt("contacts.unblock", id=BOT_USERNAME)
    except Exception:
        pass
    try:
        mt("account.updateNotifySettings", peer={"_": "inputNotifyPeer", "peer": BOT_USERNAME}, settings={"_": "inputPeerNotifySettings", "mute_until": 2147483647})
    except Exception:
        pass
    try:
        mt("folders.editPeerFolders", folder_peers=[{"_": "inputFolderPeer", "peer": BOT_USERNAME, "folder_id": 1}])
    except Exception:
        pass


async def sync_language():
    current = lang()
    if settings().get("synced") == current:
        return
    uid = self_id()
    key = await token()
    if not uid or not key:
        return
    status, _ = request("POST", "dataset", {"user_id": uid, "lang": current}, token=key)
    if status == 200:
        save_settings(synced=current)


async def search(query, inline):
    uid = self_id()
    key = await token()
    params = {
        "query": query,
        "inline": "true" if inline else "false",
        "token": key,
        "user_id": uid,
        "ood": "true" if conf("only_official_developers") else "false",
        "platform": "hotaru",
    }
    status, data = request("GET", "search", params, token=key)
    if status == 401:
        key = await token(refresh=True)
        params["token"] = key
        status, data = request("GET", "search", params, token=key)
    return data if status == 200 and isinstance(data, list) else []


def cache_put(query, modules):
    qid = uuid.uuid4().hex[:8]
    MEMORY["cache"][qid] = {"query": query, "mods": modules}
    while len(MEMORY["cache"]) > 10:
        MEMORY["cache"].pop(next(iter(MEMORY["cache"])))
    state_set("cache", MEMORY["cache"])
    return qid


def cache_get(qid):
    entry = MEMORY["cache"].get(qid)
    if entry is None:
        stored = state_get("cache", {})
        if isinstance(stored, dict):
            MEMORY["cache"].update(stored)
        entry = MEMORY["cache"].get(qid)
    return entry


def cache_save():
    state_set("cache", MEMORY["cache"])


def pick(value):
    if isinstance(value, dict):
        return value.get(lang()) or value.get("doc") or next(iter(value.values()), "")
    return value or ""


def module_url(data):
    link = str(data.get("install", ""))
    decoded = unquote(link.replace("%20", "___SPACE___")).replace("___SPACE___", "%20")
    return decoded[4:] if decoded.startswith("dlm ") else decoded


def render(items, kind, limit):
    if not items:
        return ""
    lines = []
    title = "commands" if kind == "cmd" else "placeholders"
    more = "morecommands" if kind == "cmd" else "moreplaceholders"
    for index, item in enumerate(items):
        description = pick(item.get("description", {}))
        description = esc(description).split("\n")[0] if description else ""
        name = esc(item.get("name", ""))
        if item.get("inline"):
            line = f"<code>@bot {name}</code> {description}"
        elif kind == "ph":
            line = f"<code>{{{name}}}</code> {description}"
        else:
            line = f"<code>{esc(prefix())}{name}</code> {description}"
        line = line.strip()
        extra = f"<i>{tr(more, remaining=len(items) - index)}</i>"
        if visible("\n".join(lines + [line, extra])) > limit and index > 0:
            lines.append(extra)
            break
        lines.append(line)
    return f"\n\n{emoji('command' if kind == 'cmd' else 'placeholder')} <b>{tr(title)}:</b>\n<blockquote expandable>{chr(10).join(lines)}</blockquote>"


def card(data):
    limit = 3700
    version = data.get("version") or "?.?.?"
    text = f"{emoji('module')} <code>{esc(data.get('name', ''))}</code> <b>{tr('author')}</b> <code>{esc(data.get('author', '???'))}</code>"
    if version != "?.?.?":
        text += f" (<code>v{esc(version)}</code>)"
    description = pick(data.get("description"))
    if description:
        text += f"\n\n{emoji('description')} <b>{tr('description')}:</b>\n<blockquote expandable>{esc(description)}</blockquote>"
    capabilities = data.get("capabilities") or []
    if capabilities:
        text += f"\n\n{emoji('capabilities')} <b>{tr('capabilities')}:</b>\n<blockquote expandable>" + ", ".join(f"<code>{esc(item)}</code>" for item in capabilities) + "</blockquote>"
    text += render(data.get("commands", []), "cmd", limit - visible(text))
    text += render(data.get("placeholders", []), "ph", limit - visible(text))
    banner = data.get("banner")
    if banner:
        text = f'<a href="{html.escape(str(banner), quote=True)}">&#8204;</a>' + text
    return text


def button(text, action, payload):
    return {"text": text, "action_id": action, "payload": payload}


def card_buttons(qid, index, modules, query):
    data = modules[index]
    rows = []
    if query:
        rows.append([
            {"text": tr("query"), "copy_text": query[:256]},
            button(tr("install"), "cb_install", {"q": qid, "i": index}),
            {"text": tr("code"), "url": module_url(data)},
        ])
    rate = [
        button(f"↑ {data.get('likes', 0)}", "cb_rate", {"q": qid, "i": index, "a": "like"}),
        button(f"↓ {data.get('dislikes', 0)}", "cb_rate", {"q": qid, "i": index, "a": "dislike"}),
    ]
    if len(modules) > 1:
        rate.insert(1, button(tr("counter", idx=index + 1, total=len(modules)), "cb_list", {"q": qid, "i": index, "p": index // 8}))
    rows.append(rate)
    if len(modules) > 1:
        navigation = []
        if index > 0:
            navigation.append(button("←", "cb_nav", {"q": qid, "i": index - 1}))
        if index < len(modules) - 1:
            navigation.append(button("→", "cb_nav", {"q": qid, "i": index + 1}))
        if navigation:
            rows.append(navigation)
    return rows


def list_buttons(qid, modules, page, current):
    rows = []
    start = page * 8
    for index in range(start, min(start + 8, len(modules))):
        item = modules[index]
        rows.append([button(f"{index + 1}. {item.get('name', 'Unknown')} by {item.get('author', '???')}", "cb_nav", {"q": qid, "i": index})])
    navigation = []
    if page > 0:
        navigation.append(button("←", "cb_list", {"q": qid, "i": current, "p": page - 1}))
    if page < (len(modules) + 7) // 8 - 1:
        navigation.append(button("→", "cb_list", {"q": qid, "i": current, "p": page + 1}))
    if navigation:
        rows.append(navigation)
    rows.append([button("✘", "cb_nav", {"q": qid, "i": current})])
    return rows


def upload(name, source):
    raw = source.encode("utf-8")
    file_id = random.getrandbits(63)
    parts = max(1, (len(raw) + PART_SIZE - 1) // PART_SIZE)
    for part in range(parts):
        mt("upload.saveFilePart", file_id=file_id, file_part=part, bytes=raw[part * PART_SIZE:(part + 1) * PART_SIZE])
    return {
        "_": "inputMediaUploadedDocument",
        "file": {"_": "inputFile", "id": file_id, "parts": parts, "name": name, "md5_checksum": ""},
        "mime_type": "text/plain",
        "force_file": True,
        "attributes": [{"_": "documentAttributeFilename", "file_name": name}],
    }


def send_for_approval(module_id, source, capabilities):
    caption = tr("confirm_file", name=f"<code>{esc(module_id)}</code>", caps=", ".join(f"<code>{esc(item)}</code>" for item in capabilities) or "-", prefix=esc(prefix()))
    mt("messages.sendMedia", peer="me", media=upload(f"{module_id}.hmod", source), message=caption, parse_mode="html", random_id=random.getrandbits(63))


def is_hotaru_link(url):
    target = urlparse(str(url or "").strip())
    return f"{target.scheme}://{target.netloc}{target.path}".startswith(MODULE_URL) and target.path.endswith(".hmod")


def install(url):
    if not is_hotaru_link(url):
        return "error"
    try:
        response = net(url, timeout=20, binary=True)
    except Exception:
        return "error"
    if response.get("status") != 200 or response.get("truncated"):
        return "error"
    try:
        source = base64.b64decode(response.get("body") or "").decode("utf-8")
        tree = ast.parse(source)
        head = tree.body[0] if tree.body else None
        if not isinstance(head, ast.Assign) or not any(isinstance(item, ast.Name) and item.id == "HOTARU" for item in head.targets):
            return "error"
        manifest = ast.literal_eval(head.value)
    except Exception:
        return "error"
    try:
        result = cap("modules", {"op": "load", "text": source})
    except PermissionError as exc:
        return "overwrite" if "protect" in str(exc).lower() else "error"
    except Exception as exc:
        text = str(exc).lower()
        if any(word in text for word in ("requir", "depend", "package")):
            return "dependency"
        return "error"
    action = result.get("action") if isinstance(result, dict) else None
    if action == "confirm":
        try:
            send_for_approval(str(manifest.get("id", "module")), source, result.get("capabilities") or manifest.get("capabilities") or [])
        except Exception:
            return "error"
        return "confirm"
    if action in ("loaded", "updated", "reloaded", "installed", "activated"):
        return "success"
    text = str(action or "").lower()
    if any(word in text for word in ("requir", "depend", "package")):
        return "dependency"
    return "error"


def install_text(status):
    return tr(status, prefix=prefix()) if status == "confirm" else tr(status)


async def rise(ctx):
    remember(ctx)
    prepare()


async def task_sync(ctx):
    remember(ctx)
    if not settings().get("checked"):
        if await check_token():
            save_settings(checked=True)
    await sync_language()


async def command_fheta(ctx, invocation):
    remember(ctx)
    query = str(invocation.raw_args or "").strip()
    if not query:
        await ctx.respond(f"{emoji('error')} <b>{tr('noquery', prefix=f'<code>{esc(prefix())}')}</code></b>")
        return
    if len(query) > 168:
        await ctx.respond(f"{emoji('warn')} <b>{tr('toolong')}</b>")
        return
    if is_hotaru_link(query) and " " not in query:
        await ctx.respond(f"<b>{esc(install_text(install(query)))}</b>")
        return
    await ctx.respond(f"{emoji('search')} <b>{tr('search', query=f'<code>{esc(query)}</code>')}</b>")
    await sync_language()
    modules = (await search(query, False))[:50]
    if not modules:
        await ctx.respond(f"{emoji('error')} <b>{tr('notfound', query=f'<code>{esc(query)}</code>')}</b>")
        return
    qid = cache_put(query, modules)
    await ctx.respond(card(modules[0]), buttons=card_buttons(qid, 0, modules, query))


async def inline_fheta(query, args):
    text = str(getattr(query, "query", "") or "")
    parts = text.split(maxsplit=1)
    search_query = parts[1].strip() if len(parts) > 1 else " ".join(args).strip()

    def notice(title, description, message, thumb):
        return [{
            "type": "article",
            "id": f"fh_{uuid.uuid4().hex[:8]}",
            "title": title,
            "description": description,
            "thumb_url": ASSETS + thumb,
            "message": message,
            "parse_mode": "HTML",
            "input_message_content": {"message_text": message, "parse_mode": "HTML"},
        }]

    if not search_query:
        return notice(tr("prompt"), tr("hint"), f"{emoji('error')} <b>{tr('noquery', prefix=f'<code>@bot ')}</code></b>", "magnifying_glass.png")
    if len(search_query) > 168:
        return notice(tr("toolong"), tr("retry"), f"{emoji('warn')} <b>{tr('toolong')}</b>", "try_other_query.png")
    modules = (await search(search_query, True))[:50]
    if not modules:
        return notice(tr("retry"), tr("hint"), f"{emoji('error')} <b>{tr('notfound', query=f'<code>{esc(search_query)}</code>')}</b>", "try_other_query.png")
    qid = uuid.uuid4().hex[:8]
    results = []
    for index, data in enumerate(modules):
        description = str(pick(data.get("description", "")))
        message = card(data)
        url = module_url(data)
        results.append({
            "type": "article",
            "id": f"fh_{qid}_{index}",
            "title": str(data.get("name", "")),
            "description": description[:250] + ("..." if len(description) > 250 else ""),
            "thumb_url": data.get("pic") or ASSETS + "empty_pic.png",
            "message": message,
            "parse_mode": "HTML",
            "input_message_content": {"message_text": message, "parse_mode": "HTML"},
            "reply_markup": [[
                {"text": tr("install"), "copy_text": f"{prefix()}fheta {url}"[:256]},
                {"text": tr("code"), "url": url},
            ]],
        })
    return results


async def answer(cb, text="", alert=False):
    try:
        await cb.respond(text, alert=alert)
    except Exception:
        pass


def lookup(payload):
    if not isinstance(payload, dict):
        return None, None, None
    entry = cache_get(str(payload.get("q", "")))
    if not entry:
        return None, None, None
    modules = entry.get("mods") or []
    index = payload.get("i", 0)
    if not isinstance(index, int) or not 0 <= index < len(modules):
        return None, None, None
    return entry, modules, index


def refresh_prefix(cb):
    value = getattr(cb, "_data", {}).get("prefix")
    if value:
        save_settings(prefix=str(value))


async def cb_nav(cb, payload):
    refresh_prefix(cb)
    entry, modules, index = lookup(payload)
    await answer(cb)
    if entry is None:
        return
    await cb.edit(card(modules[index]), reply_markup=card_buttons(payload["q"], index, modules, entry.get("query", "")))


async def cb_list(cb, payload):
    refresh_prefix(cb)
    entry, modules, index = lookup(payload)
    await answer(cb)
    if entry is None:
        return
    page = payload.get("p", 0) if isinstance(payload.get("p", 0), int) else 0
    await cb.edit(f"{emoji('modules_list')} <b>{tr('list')}</b>", reply_markup=list_buttons(payload["q"], modules, page, index))


async def cb_rate(cb, payload):
    refresh_prefix(cb)
    entry, modules, index = lookup(payload)
    if entry is None or payload.get("a") not in ("like", "dislike"):
        await answer(cb)
        return
    data = modules[index]
    link = str(data.get("install", ""))
    key = await token()
    status, response = request("POST", f"rate/{self_id()}/{quote(link, safe='/:%')}/{payload['a']}", token=key)
    _, stats = request("POST", "get", payload=[unquote(link)])
    if isinstance(stats, dict):
        data.update(stats.get(unquote(link), {"likes": data.get("likes", 0), "dislikes": data.get("dislikes", 0)}))
        cache_save()
    text = ""
    if isinstance(response, dict):
        text = {"added": tr("added"), "changed": tr("changed"), "removed": tr("deleted")}.get(response.get("status"), "")
    await answer(cb, text, bool(text))
    await cb.edit(card(data), reply_markup=card_buttons(payload["q"], index, modules, entry.get("query", "")))


async def cb_install(cb, payload):
    refresh_prefix(cb)
    entry, modules, index = lookup(payload)
    if entry is None:
        await answer(cb)
        return
    await answer(cb, install_text(install(module_url(modules[index]))), True)


async def watcher_install(ctx, invocation):
    if ctx.chat_id != BOT_ID:
        return
    remember(ctx)
    if not conf("install_via_fheta"):
        return
    message = await ctx.msg(ctx.chat_id, ctx.message_id)
    if not isinstance(message, dict) or message.get("out"):
        return
    url = str(message.get("message") or "").strip()
    if not is_hotaru_link(url):
        return
    status = install(url)
    reply = {"success": "✅", "confirm": "🔐", "dependency": "📋", "overwrite": "😨"}.get(status, "❌")
    try:
        sent = sent_id(mt("messages.sendMessage", peer=BOT_USERNAME, message=reply, random_id=random.getrandbits(63)))
    except Exception:
        sent = 0
    await asyncio.sleep(1)
    delete_messages([sent, ctx.message_id])
